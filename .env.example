# =============================================================================
# FieldOps - Configurações de Ambiente Local (Docker & Serviços)
# =============================================================================

# -----------------------------------------------------------------------------
# Banco de Dados PostgreSQL 16
# -----------------------------------------------------------------------------
POSTGRES_DB=fieldops_db
POSTGRES_USER=fieldops_admin
POSTGRES_PASSWORD=fieldops_secret_dev

# Porta mapeada no host (5433 por padrão para evitar conflito com instâncias locais existentes)
# Se a porta 5432 estiver livre no seu sistema, você pode alterá-la para 5432.
POSTGRES_PORT=5433

# URL de Conexão direta para Backend / Migrations
DATABASE_URL=postgresql://fieldops_admin:fieldops_secret_dev@localhost:5433/fieldops_db?schema=public

# -----------------------------------------------------------------------------
# MinIO (Object Storage compatível com AWS S3 para fotos/evidências)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=fieldops_minio_admin
MINIO_ROOT_PASSWORD=fieldops_minio_secret

# Portas mapeadas no host (9002 e 9003 por padrão para evitar conflitos de portas)
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9003

# Nome do Bucket padrão criado automaticamente para armazenamento de fotos
MINIO_BUCKET_NAME=fieldops-evidence

# Endpoints locais para o app/backend
MINIO_ENDPOINT=http://localhost:9002
MINIO_CONSOLE_URL=http://localhost:9003

# -----------------------------------------------------------------------------
# Adminer (Interface Web Leve para Gerenciamento Visual do Banco)
# -----------------------------------------------------------------------------
# Acesse no navegador em http://localhost:8085
# Servidor: postgres | Usuário: fieldops_admin | Senha: fieldops_secret_dev | Banco: fieldops_db
ADMINER_PORT=8085
