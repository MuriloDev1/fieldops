# =============================================================================
# FieldOps Web (Frontend React/Vite) - Variáveis de Ambiente
# Copie este arquivo para .env na pasta frontend/ para sobrescrever os padrões.
# =============================================================================

# URL base da API REST Spring Boot (padrão local: http://localhost:8080/api/v1)
VITE_API_URL=http://localhost:8080/api/v1

# Permite fallback para sessão de demonstração quando o backend estiver indisponível
# Defina como false em produção para exigir autenticação real do backend
VITE_ALLOW_DEMO_LOGIN=true
