  USER ||--o{ INSPECTION : assigned_supervisor

  INSPECTION_TEMPLATE ||--o{ INSPECTION_TEMPLATE_VERSION : versions
  INSPECTION_TEMPLATE_VERSION ||--o{ TEMPLATE_SECTION : contains
  TEMPLATE_SECTION ||--o{ TEMPLATE_ITEM : contains
  INSPECTION_TEMPLATE_VERSION ||--o{ INSPECTION : base_for

